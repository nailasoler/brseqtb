/*
 * brseqtb — Nextflow configuration
 * Self-contained micromamba environment
 */

nextflow.enable.dsl = 2

/*
 * ============================================================
 * GLOBAL PARAMETERS
 * ============================================================
 */
params {

  run                = null
  add_kaiju_manually = false
  cohort_demo        = false

  fastqc_cpus        = 1
  trimmomatic_cpus   = 1
  bwa_cpus           = 1
  kaiju_cpus         = 1

  lofreq_cpus        = 1
  gatk_gvcf_cpus     = 1
  gatk_vcf_cpus      = 1
  norm_cpus          = 1
  delly_cpus         = 1

  snpeff_cpus        = 1
  tbdr_rcov_cpus     = 1
  ntm_filter_cpus    = 1
  lineage_cpus       = 1

  cohort_cpus        = 1
  cohort_filter_cpus = 1

  snp_matrix_cpus    = 1
  mixinfection_cpus  = 1
  transmission_cpus  = 1
  iqtree_cpus        = 1

  resistance_target_cpus  = 1
  resistance_report_cpus  = 1

  resistance_summary_cpus = 1
  qc_summary_cpus         = 1

  clinical_report_cpus    = 1
}

/*
 * ============================================================
 * PROCESS DEFAULTS
 * ============================================================
 */
process {

  executor      = 'local'
  shell         = ['/bin/bash', '-eo', 'pipefail']
  errorStrategy = 'terminate'

  /*
   * Internal micromamba environment activation
   */
  beforeScript = '''
    mkdir -p logs
    export MAMBA_ROOT_PREFIX="$projectDir/.micromamba"
    export PATH="$MAMBA_ROOT_PREFIX/envs/brseqtb/bin:$projectDir/bin:$PATH"
  '''
}

/*
 * ============================================================
 * PROCESS TUNING
 * ============================================================
 */
process {

  /*
   * INIT BLOCK
   */
  withName: MICROMAMBA_SETUP {
    maxForks = 1
    cache = false      // 🔥 CRÍTICO: sempre recria/verifica env
  }

  withName: KAIJU_DB               { maxForks = 1 }
  withName: OMS_CATALOG            { maxForks = 1 }
  withName: BWA_REF                { maxForks = 1 }
  withName: GATK_DICT              { maxForks = 1 }
  withName: SNPEFF_DB              { maxForks = 1 }
  withName: MAKE_MANIFEST_VALIDATE { maxForks = 1 }

  /*
   * PREPROCESS
   */
  withName: FASTQC        { cpus = params.fastqc_cpus;        maxForks = 4 }
  withName: TRIMMOMATIC   { cpus = params.trimmomatic_cpus;   maxForks = 4 }
  withName: BWA           { cpus = params.bwa_cpus;           maxForks = 4 }
  withName: KAIJU         { cpus = params.kaiju_cpus;         maxForks = 4 }

  /*
   * VARIANT CALLING
   */
  withName: DELLY         { cpus = params.delly_cpus;         maxForks = 4 }
  withName: LOFREQ        { cpus = params.lofreq_cpus;        maxForks = 4 }
  withName: GATK_GVCF     { cpus = params.gatk_gvcf_cpus;     maxForks = 4 }
  withName: GATK_VCF      { cpus = params.gatk_vcf_cpus;      maxForks = 4 }
  withName: NORM          { cpus = params.norm_cpus;          maxForks = 4 }

  /*
   * ANNOTATION
   */
  withName: SNPEFF        { cpus = params.snpeff_cpus;        maxForks = 4 }
  withName: TBDR_RCOV     { cpus = params.tbdr_rcov_cpus;     maxForks = 4 }
  withName: NTM_FILTER    { cpus = params.ntm_filter_cpus;    maxForks = 4 }
  withName: LINEAGE       { cpus = params.lineage_cpus;       maxForks = 4 }

  withName: COHORT        { cpus = params.cohort_cpus;        maxForks = 1 }
  withName: COHORT_FILTER { cpus = params.cohort_filter_cpus; maxForks = 1 }

  /*
   * PHYLOGENY
   */
  withName: SNP_MATRIX    { cpus = params.snp_matrix_cpus;    maxForks = 1 }
  withName: MIXINFECTION  { cpus = params.mixinfection_cpus;  maxForks = 4 }
  withName: TRANSMISSION  { cpus = params.transmission_cpus;  maxForks = 1 }
  withName: IQTREE        { cpus = params.iqtree_cpus;        maxForks = 1 }

  /*
   * RESISTANCE
   */
  withName: RESISTANCE_TARGET  { cpus = params.resistance_target_cpus;  maxForks = 4 }
  withName: RESISTANCE_REPORT  { cpus = params.resistance_report_cpus;  maxForks = 4 }

  withName: RESISTANCE_SUMMARY { cpus = params.resistance_summary_cpus; maxForks = 1 }
  withName: QC_SUMMARY         { cpus = params.qc_summary_cpus;         maxForks = 1 }

  withName: CLINICAL_REPORT    { cpus = params.clinical_report_cpus;    maxForks = 4 }
}

/*
 * ============================================================
 * WORK DIRECTORY
 * ============================================================
 */
workDir = 'work'

/*
 * ============================================================
 * EXECUTION REPORTS
 * ============================================================
 */
trace    { enabled = true; file = 'logs/trace.txt';    overwrite = true }
timeline { enabled = true; file = 'logs/timeline.html'; overwrite = true }
report   { enabled = true; file = 'logs/report.html';   overwrite = true }
dag      { enabled = true; file = 'logs/dag.html';      overwrite = true }

/*
 * ============================================================
 * PROFILES
 * ============================================================
 */
profiles {

  local {
    process.executor = 'local'
  }

  hpc {
    process.executor = 'local'
    process.queue    = null
  }
}

