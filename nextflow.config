/*
 * brseqtb — Nextflow configuration
 * Minimal, explicit, predictable.
 */

nextflow.enable.dsl = 2


/*
 * ============================================================
 * GLOBAL PARAMETERS (defaults)
 * ============================================================
 */
params {

  /*
   * EXECUTION CONTROL
   */
  run                = null
  add_kaiju_manually = false
  cohort_demo        = false

  /*
   * BLOCK 2 — PREPROCESS
   */
  fastqc_cpus        = 1
  trimmomatic_cpus   = 1
  bwa_cpus           = 1
  kaiju_cpus         = 1

  /*
   * BLOCK 3 — VARIANT CALLING
   */
  lofreq_cpus        = 1
  gatk_gvcf_cpus     = 1
  gatk_vcf_cpus      = 1
  norm_cpus          = 1
  delly_cpus         = 1

  /*
   * BLOCK 4 — ANNOTATION + COHORT
   */
  snpeff_cpus        = 1
  tbdr_rcov_cpus     = 1
  ntm_filter_cpus    = 1
  lineage_cpus       = 1

  cohort_cpus        = 1
  cohort_filter_cpus = 1

  /*
   * BLOCK 5 — PHYLOGENY / TRANSMISSION
   */
  snp_matrix_cpus    = 1
  mixinfection_cpus  = 1
  transmission_cpus = 1
  iqtree_cpus        = 1

  /*
   * BLOCK 6 — RESISTANCE
   */
  resistance_target_cpus = 1
  resistance_report_cpus = 1

  /*
   * BLOCK 7 — SUMMARIES
   */
  resistance_summary_cpus = 1
  qc_summary_cpus         = 1

  /*
   * BLOCK 8 — CLINICAL REPORT
   */
  clinical_report_cpus    = 1
}


/*
 * ============================================================
 * PROCESS DEFAULTS
 * ============================================================
 */
process {

  executor      = 'local'
  shell         = ['/bin/bash', '-euo', 'pipefail']
  errorStrategy = 'terminate'

  /*
   * Environment bootstrap (ALL processes)
   */
  beforeScript = '''
    mkdir -p logs
    export MAMBA_ROOT_PREFIX="$projectDir/.micromamba"
    export PATH="$MAMBA_ROOT_PREFIX/envs/brseqtb/bin:$projectDir/bin:$PATH"
  '''
}


/*
 * ============================================================
 * PROCESS-SPECIFIC TUNING
 * ============================================================
 */
process {

  /*
   * ========================================================
   * BLOCK 1 — INIT (run once)
   * ========================================================
   */
  withName: MICROMAMBA_SETUP       { maxForks = 1 }
  withName: KAIJU_DB               { maxForks = 1 }
  withName: OMS_CATALOG            { maxForks = 1 }
  withName: BWA_REF                { maxForks = 1 }
  withName: GATK_DICT              { maxForks = 1 }
  withName: SNPEFF_DB              { maxForks = 1 }
  withName: MAKE_MANIFEST_VALIDATE { maxForks = 1 }

  /*
   * ========================================================
   * BLOCK 2 — PREPROCESS
   * ========================================================
   */
  withName: FASTQC {
    cpus     = params.fastqc_cpus
    maxForks = 4
  }

  withName: TRIMMOMATIC {
    cpus     = params.trimmomatic_cpus
    maxForks = 4
  }

  withName: BWA {
    cpus     = params.bwa_cpus
    maxForks = 4
  }

  withName: KAIJU {
    cpus     = params.kaiju_cpus
    maxForks = 4
  }

  /*
   * ========================================================
   * BLOCK 3 — VARIANT CALLING
   * ========================================================
   */
  withName: DELLY {
    cpus     = params.delly_cpus
    maxForks = 4
  }

  withName: LOFREQ {
    cpus     = params.lofreq_cpus
    maxForks = 4
  }

  withName: GATK_GVCF {
    cpus     = params.gatk_gvcf_cpus
    maxForks = 4
  }

  withName: GATK_VCF {
    cpus     = params.gatk_vcf_cpus
    maxForks = 4
  }

  withName: NORM {
    cpus     = params.norm_cpus
    maxForks = 4
  }

  /*
   * ========================================================
   * BLOCK 4 — ANNOTATION + COHORT
   * ========================================================
   */
  withName: SNPEFF {
    cpus     = params.snpeff_cpus
    maxForks = 4
  }

  withName: TBDR_RCOV {
    cpus     = params.tbdr_rcov_cpus
    maxForks = 4
  }

  withName: NTM_FILTER {
    cpus     = params.ntm_filter_cpus
    maxForks = 4
  }

  withName: LINEAGE {
    cpus     = params.lineage_cpus
    maxForks = 4
  }

  withName: COHORT {
    cpus     = params.cohort_cpus
    maxForks = 1
  }

  withName: COHORT_FILTER {
    cpus     = params.cohort_filter_cpus
    maxForks = 1
  }

  /*
   * ========================================================
   * BLOCK 5 — PHYLOGENY / TRANSMISSION
   * ========================================================
   */
  withName: SNP_MATRIX {
    cpus     = params.snp_matrix_cpus
    maxForks = 1
  }

  withName: MIXINFECTION {
    cpus     = params.mixinfection_cpus
    maxForks = 4
  }

  withName: TRANSMISSION {
    cpus     = params.transmission_cpus
    maxForks = 1
  }

  withName: IQTREE {
    cpus     = params.iqtree_cpus
    maxForks = 1
  }

  /*
   * ========================================================
   * BLOCK 6 — RESISTANCE
   * ========================================================
   */
  withName: RESISTANCE_TARGET {
    cpus     = params.resistance_target_cpus
    maxForks = 4
  }

  withName: RESISTANCE_REPORT {
    cpus     = params.resistance_report_cpus
    maxForks = 4
  }

  /*
   * ========================================================
   * BLOCK 7 — SUMMARIES (coorte)
   * ========================================================
   */
  withName: RESISTANCE_SUMMARY {
    cpus     = params.resistance_summary_cpus
    maxForks = 1
  }

  withName: QC_SUMMARY {
    cpus     = params.qc_summary_cpus
    maxForks = 1
  }

  /*
   * ========================================================
   * BLOCK 8 — CLINICAL REPORT
   * ========================================================
   */
  withName: CLINICAL_REPORT {
    cpus     = params.clinical_report_cpus
    maxForks = 4
  }
}


/*
 * ============================================================
 * WORK DIRECTORY
 * ============================================================
 */
workDir = 'work'


/*
 * ============================================================
 * EXECUTION REPORTS
 * ============================================================
 */
trace {
  enabled   = true
  file      = 'logs/trace.txt'
  overwrite = true
}

timeline {
  enabled   = true
  file      = 'logs/timeline.html'
  overwrite = true
}

report {
  enabled   = true
  file      = 'logs/report.html'
  overwrite = true
}

dag {
  enabled   = true
  file      = 'logs/dag.html'
  overwrite = true
}


/*
 * ============================================================
 * PROFILES
 * ============================================================
 */
profiles {

  local {
    process.executor = 'local'
  }

  hpc {
    process.executor = 'local'
    process.queue    = null
  }
}
