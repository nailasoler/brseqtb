/*
 * brseqtb — Production Config
 * Default: Conda
 * Optional: Micromamba profile
 */

nextflow.enable.dsl = 2

params {
  run                = null
  add_kaiju_manually = false
  input_table        = "input/input_table.xlsx"
  reads_dir          = "reads"
}

/*
 * DEFAULT = CONDA
 */

conda {
  enabled  = true
  useMamba = false
  cacheDir = "$HOME/.nextflow_conda_cache"
}

process {

  executor      = 'local'
  shell         = ['/bin/bash', '-euo', 'pipefail']
  errorStrategy = 'terminate'
  conda         = "$projectDir/envs/brseqtb.yml"

  withName: KAIJU_DB               { cpus = 1; maxForks = 1 }
  withName: OMS_CATALOG            { cpus = 1; maxForks = 1 }
  withName: BWA_REF                { cpus = 1; maxForks = 1 }
  withName: GATK_DICT              { cpus = 1; maxForks = 1 }
  withName: SNPEFF_DB              { cpus = 1; maxForks = 1 }
  withName: MAKE_MANIFEST_VALIDATE { cpus = 1; maxForks = 1 }
}

/*
 * OPTIONAL PROFILE = MICROMAMBA
 */

profiles {

  micromamba {
    conda {
      enabled  = true
      useMamba = true
      cacheDir = "$HOME/.nextflow_conda_cache"
    }
  }

}

workDir = 'work'

trace {
  enabled   = true
  file      = 'logs/trace.txt'
  overwrite = true
}

timeline {
  enabled   = true
  file      = 'logs/timeline.html'
  overwrite = true
}

report {
  enabled   = true
  file      = 'logs/report.html'
  overwrite = true
}

dag {
  enabled   = true
  file      = 'logs/dag.html'
  overwrite = true
}
