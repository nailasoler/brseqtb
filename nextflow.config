/*
 * brseqtb — INIT BLOCK CONFIG
 * Default: micromamba
 * Optional: conda fallback
 */

nextflow.enable.dsl = 2

/*
 * ============================================================
 * GLOBAL PARAMETERS
 * ============================================================
 */

params {

  run                = null
  add_kaiju_manually = false

  input_table = "input/input_table.xlsx"
  reads_dir   = "reads"
}

/*
 * ============================================================
 * DEFAULT PROFILE (micromamba)
 * ============================================================
 */

profiles {

  standard {

    process.executor      = 'local'
    process.shell         = ['/bin/bash', '-euo', 'pipefail']
    process.errorStrategy = 'terminate'
    process.conda         = "$projectDir/envs/brseqtb.yml"

    conda {
      enabled     = true
      useMamba    = true
      mambaBinary = 'micromamba'
    }
  }

  /*
   * ============================================================
   * CONDA FALLBACK PROFILE
   * ============================================================
   */

  conda_profile {

    process.executor      = 'local'
    process.shell         = ['/bin/bash', '-euo', 'pipefail']
    process.errorStrategy = 'terminate'
    process.conda         = "$projectDir/envs/brseqtb.yml"

    conda {
      enabled  = true
      useMamba = false
    }
  }

  /*
   * ============================================================
   * EXPLICIT MICROMAMBA PROFILE (optional explicit call)
   * ============================================================
   */

  micromamba_profile {

    process.executor      = 'local'
    process.shell         = ['/bin/bash', '-euo', 'pipefail']
    process.errorStrategy = 'terminate'
    process.conda         = "$projectDir/envs/brseqtb.yml"

    conda {
      enabled     = true
      useMamba    = true
      mambaBinary = 'micromamba'
    }
  }
}

/*
 * ============================================================
 * INIT CHAIN — always sequential
 * ============================================================
 */

process {

  withName: KAIJU_DB               { cpus = 1; maxForks = 1 }
  withName: OMS_CATALOG            { cpus = 1; maxForks = 1 }
  withName: BWA_REF                { cpus = 1; maxForks = 1 }
  withName: GATK_DICT              { cpus = 1; maxForks = 1 }
  withName: SNPEFF_DB              { cpus = 1; maxForks = 1 }
  withName: MAKE_MANIFEST_VALIDATE { cpus = 1; maxForks = 1 }
}

/*
 * ============================================================
 * WORK DIRECTORY
 * ============================================================
 */

workDir = 'work'

trace {
  enabled   = true
  file      = 'logs/trace.txt'
  overwrite = true
}

timeline {
  enabled   = true
  file      = 'logs/timeline.html'
  overwrite = true
}

report {
  enabled   = true
  file      = 'logs/report.html'
  overwrite = true
}

dag {
  enabled   = true
  file      = 'logs/dag.html'
  overwrite = true
}
