/*
 * brseqtb — INIT BLOCK CONFIG
 * Default environment: micromamba
 * Optional fallback: conda
 */

nextflow.enable.dsl = 2

/*
 * ============================================================
 * GLOBAL PARAMETERS
 * ============================================================
 */

params {

  run                = null
  add_kaiju_manually = false

  input_table = "input/input_table.xlsx"
  reads_dir   = "reads"
}

/*
 * ============================================================
 * DEFAULT ENVIRONMENT (micromamba)
 * ============================================================
 */

conda {
  enabled     = true
  useMamba    = true
  mambaBinary = 'micromamba'
}

/*
 * ============================================================
 * PROCESS DEFAULTS
 * ============================================================
 */

process {

  executor      = 'local'
  shell         = ['/bin/bash', '-euo', 'pipefail']
  errorStrategy = 'terminate'
  conda         = "$projectDir/envs/brseqtb.yml"

  /*
   * INIT CHAIN — always sequential
   */

  withName: KAIJU_DB               { cpus = 1; maxForks = 1 }
  withName: OMS_CATALOG            { cpus = 1; maxForks = 1 }
  withName: BWA_REF                { cpus = 1; maxForks = 1 }
  withName: GATK_DICT              { cpus = 1; maxForks = 1 }
  withName: SNPEFF_DB              { cpus = 1; maxForks = 1 }
  withName: MAKE_MANIFEST_VALIDATE { cpus = 1; maxForks = 1 }
}

/*
 * ============================================================
 * OPTIONAL PROFILES
 * ============================================================
 */

profiles {

  /*
   * Use traditional conda instead of micromamba
   */

  conda_profile {
    conda {
      enabled  = true
      useMamba = false
    }
  }

  /*
   * Explicit micromamba (same as default, optional clarity)
   */

  micromamba_profile {
    conda {
      enabled     = true
      useMamba    = true
      mambaBinary = 'micromamba'
    }
  }
}

/*
 * ============================================================
 * WORK DIRECTORY
 * ============================================================
 */

workDir = 'work'

trace {
  enabled   = true
  file      = 'logs/trace.txt'
  overwrite = true
}

timeline {
  enabled   = true
  file      = 'logs/timeline.html'
  overwrite = true
}

report {
  enabled   = true
  file      = 'logs/report.html'
  overwrite = true
}

dag {
  enabled   = true
  file      = 'logs/dag.html'
  overwrite = true
}
