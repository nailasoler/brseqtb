/*
 * brseqtb — Production Config
 * Portable / Micromamba-ready
 * Persistent environment cache
 */

nextflow.enable.dsl = 2

/*
 * ============================================================
 * GLOBAL PARAMETERS
 * ============================================================
 */

params {
  run                = null
  add_kaiju_manually = false
  input_table        = "input/input_table.xlsx"
  reads_dir          = "reads"
}

/*
 * ============================================================
 * ENVIRONMENT (MAMBA / MICROMAMBA)
 * ============================================================
 *
 * Nextflow will call `mamba`.
 * If micromamba is installed, create:
 *   ln -s $(which micromamba) /usr/local/bin/mamba
 *
 * No conda required.
 */

conda {
  enabled  = true
  useMamba = true
  cacheDir = "$HOME/.nextflow_conda_cache"
}

/*
 * ============================================================
 * PROCESS DEFAULTS
 * ============================================================
 */

process {

  executor      = 'local'
  shell         = ['/bin/bash', '-euo', 'pipefail']
  errorStrategy = 'terminate'
  conda         = "$projectDir/envs/brseqtb.yml"

  /*
   * BLOCK 1 — Sequential (Infrastructure)
   */

  withName: KAIJU_DB               { cpus = 1; maxForks = 1 }
  withName: OMS_CATALOG            { cpus = 1; maxForks = 1 }
  withName: BWA_REF                { cpus = 1; maxForks = 1 }
  withName: GATK_DICT              { cpus = 1; maxForks = 1 }
  withName: SNPEFF_DB              { cpus = 1; maxForks = 1 }
  withName: MAKE_MANIFEST_VALIDATE { cpus = 1; maxForks = 1 }
}

/*
 * ============================================================
 * WORK DIRECTORY
 * ============================================================
 */

workDir = 'work'

trace {
  enabled   = true
  file      = 'logs/trace.txt'
  overwrite = true
}

timeline {
  enabled   = true
  file      = 'logs/timeline.html'
  overwrite = true
}

report {
  enabled   = true
  file      = 'logs/report.html'
  overwrite = true
}

dag {
  enabled   = true
  file      = 'logs/dag.html'
  overwrite = true
}
